{
  "name": "map-chart-monorepo",
  "version": "0.0.1",
  "description": "A monorepo for developing the map-chart component libraries",
  "author": "Noé Gnanih <noegnanih@gmail.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs": "pnpm -F docs run dev",
    "dev": "pnpm -F playground-vue run dev",
    "dev-react": "pnpm -F playground-react run dev",
    "test": "pnpm -F '@map-chart/core' -F vue3-map-chart -F vue3-map-chart-lite -F '@arkn/react-map-chart' -F '@arkn/react-map-chart-lite' run test",
    "test-ci": "pnpm -F '@map-chart/core' -F vue3-map-chart -F vue3-map-chart-lite -F '@arkn/react-map-chart' -F '@arkn/react-map-chart-lite' run test-ci",
    "build": "pnpm build-plugin && pnpm build-plugin-lite && pnpm build-plugin-react && pnpm build-plugin-react-lite && pnpm build-playground && pnpm build-playground-react && pnpm build-docs",
    "build-plugin": "pnpm -r -F vue3-map-chart run build",
    "build-plugin-lite": "pnpm -r -F vue3-map-chart-lite run build",
    "build-plugin-react": "pnpm -r -F '@arkn/react-map-chart' run build",
    "build-plugin-react-lite": "pnpm -r -F '@arkn/react-map-chart-lite' run build",
    "build-playground": "pnpm -F playground-vue run build",
    "build-playground-react": "pnpm -F playground-react run build",
    "build-docs": "pnpm -F docs run build",
    "lint": "eslint --ext .js,.ts,.vue,.tsx .",
    "lint:fix": "eslint --ext .js,.ts,.vue,.tsx . --fix",
    "format": "prettier . --write",
    "commit": "git add --all && git commit",
    "commit-push": "git add --all && git commit && git push origin --all",
    "execute-husky": "npx husky install && npx husky add .husky/pre-commit \"npx --no-install lint-staged\"",
    "deploy-playground": "pnpm -F playground-vue run deploy"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,vue,tsx}": [
      "eslint . --fix",
      "prettier . --write"
    ]
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  }
}